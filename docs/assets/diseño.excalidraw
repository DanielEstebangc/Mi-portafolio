    {
      "id": "rFc3gzDA9yMV27KHysd1X",
      "type": "text",
      "x": 1107.8763078962056,
      "y": 810.8857312883649,
      "width": 974.1593627929688,
      "height": 425,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
